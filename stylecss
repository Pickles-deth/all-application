html { scroll-behavior: smooth; }

[data-testid="stAppViewContainer"]{
  background:
    radial-gradient(circle at 8% 17%, rgba(255,255,255,.74) 0 4%, transparent 4.2%),
    radial-gradient(circle at 80% 11%, rgba(255,255,255,.63) 0 5%, transparent 5.2%),
    linear-gradient(180deg,#8fdcff 0%,#d9f7ff 37%,#73dad2 67%,#5cbb86 100%);
  background-attachment: fixed;
}

[data-testid="stHeader"] { background: rgba(0,0,0,0); }
#MainMenu, footer { visibility: hidden; }

.block-container{
  max-width: 1200px;
  padding-top: 2rem;
  padding-bottom: 7rem;
}

/* ---------- Startup bubbles ---------- */

.bubble-stage{
  position: fixed;
  inset: 0;
  z-index: 9999;
  overflow: hidden;
  pointer-events: none;
  animation: bubbleStageOut 4.2s ease forwards;
}

@keyframes bubbleStageOut{
  0%,76% { opacity:1; }
  100% { opacity:0; visibility:hidden; }
}

.bubble{
  position:absolute;
  bottom:-140px;
  border-radius:50%;
  border:1.5px solid rgba(255,255,255,.88);
  background:
    radial-gradient(circle at 30% 24%,
      rgba(255,255,255,.92) 0 5%,
      rgba(255,255,255,.36) 8%,
      rgba(111,224,255,.20) 40%,
      rgba(63,187,227,.09) 65%,
      rgba(255,255,255,.18) 100%);
  box-shadow:
    inset -7px -8px 16px rgba(20,154,207,.16),
    inset 8px 7px 13px rgba(255,255,255,.33),
    0 8px 25px rgba(15,126,164,.12);
}

.b1{left:5%; width:72px;height:72px; animation:rise1 3.2s ease-out .00s forwards;}
.b2{left:19%;width:42px;height:42px; animation:rise2 3.5s ease-out .22s forwards;}
.b3{left:31%;width:96px;height:96px; animation:rise1 3.8s ease-out .10s forwards;}
.b4{left:47%;width:54px;height:54px; animation:rise2 3.1s ease-out .45s forwards;}
.b5{left:61%;width:82px;height:82px; animation:rise1 3.7s ease-out .18s forwards;}
.b6{left:75%;width:48px;height:48px; animation:rise2 3.2s ease-out .36s forwards;}
.b7{left:88%;width:105px;height:105px;animation:rise1 3.9s ease-out .05s forwards;}
.b8{left:40%;width:30px;height:30px; animation:rise2 2.9s ease-out .62s forwards;}

@keyframes rise1{
  0%{transform:translate(0,0) scale(.72);opacity:0}
  12%{opacity:.92}
  68%{opacity:.82}
  100%{transform:translate(45px,-115vh) scale(1.08);opacity:0}
}

@keyframes rise2{
  0%{transform:translate(0,0) scale(.62);opacity:0}
  12%{opacity:.88}
  70%{opacity:.75}
  100%{transform:translate(-34px,-112vh) scale(1.0);opacity:0}
}

/* ---------- Hero ---------- */

.aero-hero{
  position:relative;
  overflow:hidden;
  border:1px solid rgba(255,255,255,.84);
  border-radius:20px;
  padding:28px 30px 24px;
